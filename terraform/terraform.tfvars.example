# Copy this file to terraform.tfvars and replace values as needed.
# Do not commit terraform.tfvars or put database credentials in this file.
# db_admin_username and db_admin_password must be supplied through
# TF_VAR_db_admin_username / TF_VAR_db_admin_password or pipeline secrets.

project_name            = "epicbook"
aws_region              = "ap-south-1"
vpc_cidr                = "10.20.0.0/16"
public_subnet_cidr      = "10.20.1.0/24"
private_subnet_cidr     = "10.20.2.0/24"
private_subnet_cidr_2   = "10.20.3.0/24"
instance_type           = "t3.micro"
db_instance_class       = "db.t3.micro"
ssh_public_key_path     = "~/.ssh/agent.pub"
allowed_admin_ip        = "203.0.113.10/32"
pipeline_agent_ip       = "198.51.100.10/32"
backend_app_port        = 8080
db_name                 = "epicbook"

# db_admin_username = set via TF_VAR_db_admin_username
# db_admin_password = set via TF_VAR_db_admin_password
